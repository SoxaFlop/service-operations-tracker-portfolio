# Copy this file to .env and replace every placeholder before running the API.
# Never commit .env or any real credentials.

# PostgreSQL
DATABASE_URL="replace-with-postgresql-connection-string"

# Authentication
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"
ALLOWED_EMAIL_DOMAINS="example.com"
ADMIN_EMAILS="admin@example.com"

# Application
APP_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
PORT="3000"
NODE_ENV="development"

# Optional SMTP delivery. Keep EMAIL_ENABLED=false for a local code review.
EMAIL_ENABLED="false"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="mailer@example.com"
SMTP_PASS="replace-with-an-app-password"
FROM_EMAIL="Service Operations Tracker <no-reply@example.com>"

# Optional demo seed values. Use fictional accounts only.
DEMO_ADMIN_EMAIL="admin@example.com"
DEMO_ADMIN_NAME="Demo Administrator"
DEMO_ADMIN_PASSWORD="replace-with-a-demo-password"
